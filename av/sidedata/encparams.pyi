from enum import IntEnum
from typing import Self, final

import numpy as np

from .sidedata import SideData

class VideoEncParamsType(IntEnum):
    NONE = ...
    VP9 = ...
    H264 = ...
    MPEG2 = ...

@final
class VideoEncParams(SideData):
    @property
    def nb_blocks(self) -> int: ...
    @property
    def blocks_offset(self) -> int: ...
    @property
    def block_size(self) -> int: ...
    @property
    def codec_type(self) -> VideoEncParamsType: ...
    @property
    def qp(self) -> int: ...
    @property
    def delta_qp(self) -> list[list[int]]: ...
    def block_params(self, idx: int) -> VideoBlockParams: ...
    def qp_map(self) -> np.ndarray[tuple[int, int], np.dtype[np.int32]]: ...

@final
class VideoBlockParams:
    @property
    def src_x(self) -> int: ...
    @property
    def src_y(self) -> int: ...
    @property
    def w(self) -> int: ...
    @property
    def h(self) -> int: ...
    @property
    def delta_qp(self) -> int: ...
    def __new__(cls, video_enc_params: VideoEncParams, idx: int, /) -> Self: ...
