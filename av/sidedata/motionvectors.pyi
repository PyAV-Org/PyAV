from collections.abc import Iterator
from typing import Self, final

import numpy as np
import numpy.typing as npt

from av.frame import Frame

from .sidedata import SideData

@final
class MotionVectors(SideData):
    def __new__(cls, sentinel: object, frame: Frame, index: int, /) -> Self: ...
    def __getitem__(self, index: int, /) -> MotionVector: ...
    def __iter__(self) -> Iterator[MotionVector]: ...
    def __len__(self) -> int: ...
    def to_ndarray(self) -> npt.NDArray[np.void]: ...

@final
class MotionVector:
    @property
    def source(self) -> int: ...
    @property
    def w(self) -> int: ...
    @property
    def h(self) -> int: ...
    @property
    def src_x(self) -> int: ...
    @property
    def src_y(self) -> int: ...
    @property
    def dst_x(self) -> int: ...
    @property
    def dst_y(self) -> int: ...
    @property
    def motion_x(self) -> int: ...
    @property
    def motion_y(self) -> int: ...
    @property
    def motion_scale(self) -> int: ...
    def __new__(
        cls, sentinel: object, parent: MotionVectors, index: int, /
    ) -> Self: ...
