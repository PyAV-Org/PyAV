from enum import IntEnum, IntFlag
from fractions import Fraction
from typing import Literal, final

from typing_extensions import disjoint_base

from av.rational import AVRational

from .codec import CodecContext
from .container import Container
from .index import IndexEntries

class Disposition(IntFlag):
    default = ...
    dub = ...
    original = ...
    comment = ...
    lyrics = ...
    karaoke = ...
    forced = ...
    hearing_impaired = ...
    visual_impaired = ...
    clean_effects = ...
    attached_pic = ...
    timed_thumbnails = ...
    non_diegetic = ...
    captions = ...
    descriptions = ...
    metadata = ...
    dependent = ...
    still_image = ...
    multilayer = ...

class Discard(IntEnum):
    none = ...
    default = ...
    nonref = ...
    bidir = ...
    nonintra = ...
    nonkey = ...
    all = ...

@disjoint_base
class Stream:
    @property
    def name(self) -> str | None: ...
    @property
    def container(self) -> Container: ...
    @property
    def cctx(self) -> CodecContext | None: ...
    @property
    def codec_context(self) -> CodecContext | None: ...
    @property
    def metadata(self) -> dict[str, str]: ...
    @property
    def index_entries(self) -> IndexEntries: ...
    id: int
    @property
    def profiles(self) -> list[str]: ...
    profile: str | None
    @property
    def index(self) -> int: ...
    @property
    def time_base(self) -> AVRational: ...
    @time_base.setter
    def time_base(self, value: AVRational | Fraction | int) -> None: ...
    @property
    def start_time(self) -> int | None: ...
    @property
    def duration(self) -> int | None: ...
    disposition: Disposition
    discard: Discard
    @property
    def frames(self) -> int: ...
    @property
    def language(self) -> str | None: ...
    @property
    def type(
        self,
    ) -> Literal["video", "audio", "data", "subtitle", "attachment", "unknown"]: ...

@final
class DataStream(Stream):
    @property
    def cctx(self) -> None: ...
    @property
    def codec_context(self) -> None: ...
    @property
    def type(self) -> Literal["data"]: ...

@final
class AttachmentStream(Stream):
    @property
    def cctx(self) -> None: ...
    @property
    def codec_context(self) -> None: ...
    @property
    def type(self) -> Literal["attachment"]: ...
    @property
    def mimetype(self) -> str | None: ...
    @property
    def data(self) -> bytes: ...
