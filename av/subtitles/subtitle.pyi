from collections.abc import Iterator
from typing import Literal, final

from typing_extensions import disjoint_base

@final
class SubtitleProxy: ...

@final
class SubtitleSet:
    format: int
    start_display_time: int
    end_display_time: int
    pts: int
    @property
    def rects(self) -> tuple[AssSubtitle | BitmapSubtitle, ...]: ...
    @staticmethod
    def create(
        text: bytes, start: int, end: int, pts: int = 0, subtitle_format: int = 1
    ) -> SubtitleSet: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[AssSubtitle | BitmapSubtitle]: ...
    def __getitem__(self, i: int, /) -> AssSubtitle | BitmapSubtitle: ...

@disjoint_base
class Subtitle:
    @property
    def type(self) -> bytes: ...

@final
class BitmapSubtitle(Subtitle):
    @property
    def type(self) -> Literal[b"bitmap"]: ...
    @property
    def x(self) -> int: ...
    @property
    def y(self) -> int: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def nb_colors(self) -> int: ...
    @property
    def planes(self) -> tuple[BitmapSubtitlePlane, ...]: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[BitmapSubtitlePlane]: ...
    def __getitem__(self, i: int, /) -> BitmapSubtitlePlane: ...

@final
class BitmapSubtitlePlane:
    @property
    def subtitle(self) -> BitmapSubtitle: ...
    @property
    def index(self) -> int: ...
    @property
    def buffer_size(self) -> int: ...
    def __buffer__(self, flags: int, /) -> memoryview: ...

@final
class AssSubtitle(Subtitle):
    @property
    def type(self) -> Literal[b"ass", b"text"]: ...
    @property
    def ass(self) -> bytes: ...
    @property
    def dialogue(self) -> bytes: ...
    @property
    def text(self) -> bytes: ...
