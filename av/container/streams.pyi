from collections.abc import Iterator
from typing import Literal, final, overload

from av.audio.stream import AudioStream
from av.stream import AttachmentStream, DataStream, Stream
from av.subtitles.stream import SubtitleStream
from av.video.stream import VideoStream

type _Indices = int | tuple[int, ...] | list[int]
type _StreamSelector = (
    int | Stream | tuple[int | Stream, ...] | list[int | Stream] | dict[str, _Indices]
)

@final
class StreamContainer:
    @property
    def video(self) -> tuple[VideoStream, ...]: ...
    @property
    def audio(self) -> tuple[AudioStream, ...]: ...
    @property
    def subtitles(self) -> tuple[SubtitleStream, ...]: ...
    @property
    def attachments(self) -> tuple[AttachmentStream, ...]: ...
    @property
    def data(self) -> tuple[DataStream, ...]: ...
    def __init__(self) -> None: ...
    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Stream]: ...
    @overload
    def __getitem__(self, index: int, /) -> Stream: ...
    @overload
    def __getitem__(self, index: slice, /) -> list[Stream]: ...
    def get(self, *args: _StreamSelector, **kwargs: _Indices) -> list[Stream]: ...
    def best(
        self,
        type: Literal["video", "audio", "subtitle", "data", "attachment"],
        /,
        related: Stream | None = None,
    ) -> Stream | None: ...
