from typing import final

from typing_extensions import disjoint_base

from av.filter.context import FilterContext
from av.filter.filter import Filter
from av.filter.graph import Graph

@disjoint_base
class FilterPad:
    @property
    def filter(self) -> Filter: ...
    @property
    def context(self) -> FilterContext | None: ...
    @property
    def is_input(self) -> bool: ...
    @property
    def index(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    @property
    def is_output(self) -> bool: ...
    @property
    def name(self) -> str: ...
    @property
    def type(self) -> str: ...

@final
class FilterContextPad(FilterPad):
    @property
    def context(self) -> FilterContext: ...
    @property
    def link(self) -> FilterLink | None: ...
    @property
    def linked(self) -> FilterContextPad | None: ...

@final
class FilterLink:
    @property
    def graph(self) -> Graph: ...
    @property
    def input(self) -> FilterContextPad: ...
    @property
    def output(self) -> FilterContextPad: ...
