from typing import Self, final

@final
class VideoFormat:
    @property
    def name(self) -> str: ...
    @property
    def bits_per_pixel(self) -> int: ...
    @property
    def padded_bits_per_pixel(self) -> int: ...
    @property
    def is_big_endian(self) -> bool: ...
    @property
    def has_palette(self) -> bool: ...
    @property
    def is_bit_stream(self) -> bool: ...
    @property
    def is_planar(self) -> bool: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def components(self) -> tuple[VideoFormatComponent, ...]: ...
    @property
    def is_rgb(self) -> bool: ...
    @property
    def is_bayer(self) -> bool: ...
    def __new__(
        cls, name: str | VideoFormat, width: int = 0, height: int = 0
    ) -> Self: ...
    def chroma_width(self, luma_width: int = 0) -> int: ...
    def chroma_height(self, luma_height: int = 0) -> int: ...
    def __int__(self) -> int: ...

@final
class VideoFormatComponent:
    @property
    def index(self) -> int: ...
    @property
    def plane(self) -> int: ...
    @property
    def bits(self) -> int: ...
    @property
    def is_alpha(self) -> bool: ...
    @property
    def is_luma(self) -> bool: ...
    @property
    def is_chroma(self) -> bool: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    def __new__(cls, format: VideoFormat, index: int) -> Self: ...

names: set[str]
