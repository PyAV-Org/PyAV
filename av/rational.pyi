from decimal import Decimal
from fractions import Fraction
from numbers import Rational
from typing import final, overload

type _Comparable = AVRational | Rational | Decimal | float

@final
class AVRational:
    num: int
    den: int
    def __init__(self, num: int | Rational = 0, den: int = 1) -> None: ...
    @property
    def numerator(self) -> int: ...
    @property
    def denominator(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __float__(self) -> float: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __lt__(self, other: _Comparable, /) -> bool: ...
    def __le__(self, other: _Comparable, /) -> bool: ...
    def __gt__(self, other: _Comparable, /) -> bool: ...
    def __ge__(self, other: _Comparable, /) -> bool: ...
    def __neg__(self) -> AVRational: ...
    @overload
    def __mul__(self, other: AVRational, /) -> AVRational: ...
    @overload
    def __mul__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __mul__(self, other: float, /) -> float: ...
    @overload
    def __rmul__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __rmul__(self, other: float, /) -> float: ...
    @overload
    def __truediv__(self, other: AVRational, /) -> AVRational: ...
    @overload
    def __truediv__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __truediv__(self, other: float, /) -> float: ...
    @overload
    def __rtruediv__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __rtruediv__(self, other: float, /) -> float: ...
    @overload
    def __add__(self, other: AVRational, /) -> AVRational: ...
    @overload
    def __add__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __add__(self, other: float, /) -> float: ...
    @overload
    def __radd__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __radd__(self, other: float, /) -> float: ...
    @overload
    def __sub__(self, other: AVRational, /) -> AVRational: ...
    @overload
    def __sub__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __sub__(self, other: float, /) -> float: ...
    @overload
    def __rsub__(self, other: int | Fraction, /) -> Fraction: ...
    @overload
    def __rsub__(self, other: float, /) -> float: ...
